{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumoney-shop",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jumoney-ticket-db",
      "database_id": "44bdadbb-2527-46ed-ae70-f9db40a3984b",
      "migrations_dir": "migrations"
    }
  ]
}
